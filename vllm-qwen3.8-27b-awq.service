[Unit]
Description=vLLM serving cyankiwi/Qwen3.8-27B-AWQ-INT4
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vllm
Group=vllm
WorkingDirectory=/opt/vllm
Environment=HF_HOME=/opt/vllm/hf-cache
Environment=UV_CACHE_DIR=/opt/vllm/uv-cache
Environment=UV_PROJECT_ENVIRONMENT=/opt/vllm/.venv
Environment=XDG_CACHE_HOME=/opt/vllm/cache
Environment=VLLM_NO_USAGE_STATS=1
Environment=DO_NOT_TRACK=1
Environment=CUDA_VISIBLE_DEVICES=0
Environment=VLLM_USE_FLASHINFER_SAMPLER=0
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ExecStart=/opt/vllm/bin/uv run vllm serve cyankiwi/Qwen3.8-27B-AWQ-INT4 \
    --served-model-name qwen3.8-27b \
    --port 10014 \
    --tensor-parallel-size 1 \
    --max-model-len 32768 \
    --gpu-memory-utilization 0.97 \
    --max-num-seqs 4 \
    --max-num-batched-tokens 2048 \
    --enable-prefix-caching \
    --async-scheduling \
    --limit-mm-per-prompt '{"video": 0}' \
    --skip-mm-profiling \
    --enable-chunked-prefill \
    --enable-auto-tool-choice \
    --tool-call-parser qwen3_coder \
    --reasoning-parser qwen3 \
    --default-chat-template-kwargs '{"reasoning_effort": "low"}' \
    --generation-config auto
Restart=always
RestartSec=10
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
