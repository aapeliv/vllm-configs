[Unit]
Description=vLLM serving qwen/qwen3.6-27b-fp8
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vllm
Group=vllm
WorkingDirectory=/opt/vllm
Environment=HF_HOME=/opt/vllm/hf-cache
Environment=UV_CACHE_DIR=/opt/vllm/uv-cache
Environment=UV_PROJECT_ENVIRONMENT=/opt/vllm/.venv
Environment=XDG_CACHE_HOME=/opt/vllm/cache
Environment=VLLM_NO_USAGE_STATS=1
Environment=DO_NOT_TRACK=1
Environment=VLLM_USE_FLASHINFER_SAMPLER=0
ExecStart=/opt/vllm/bin/uv run vllm serve Qwen/Qwen3.6-27B-FP8 \
    --served-model-name qwen3.6-27b \
    --port 10013 \
    --tensor-parallel-size=2 \
    --max-model-len=65536 \
    --gpu-memory-utilization=0.95 \
    --max-num-seqs 8 \
    --scheduling-policy priority \
    --enable-auto-tool-choice \
    --tool-call-parser qwen3_coder \
    --reasoning-parser qwen3 \
    --speculative-config '{"method": "mtp", "num_speculative_tokens": 4}' \
    --kv-cache-dtype fp8 \
    --enable-chunked-prefill
Restart=on-failure
RestartSec=10
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
